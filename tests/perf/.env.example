# Copy to `tests/perf/.env` (gitignored). Used by run-macro.sh.

# Enclave origin (required) — NLB DNS or other reachable HTTPS base URL.
export ENCLAVE_URL=https://xxxx.elb.us-east-1.amazonaws.com

# Skip TLS verification when hitting the raw NLB DNS (hostname ≠ nitrum.local).
# export ENCLAVE_TLS_INSECURE=1

# Load shape (defaults: 50 VUs for 30s).
# export PERF_VUS=50
# export PERF_DURATION=30s

# Comma-separated routes to run (allowed: health, crypto).
# export PERF_ROUTES=health,crypto

# Optional override for k6 summary + markdown output directory.
# export PERF_RESULTS_DIR=/tmp/nitrum-macro-results

# Wait-for-ready knobs (same defaults as tests/e2e/cloud.sh).
# export WAIT_ACTIVE_TIMEOUT_SECONDS=300
# export WAIT_ACTIVE_POLL_SECONDS=5
