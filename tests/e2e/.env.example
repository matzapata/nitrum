# Copy to `tests/e2e/.env` (gitignored). Used by build.sh, local.sh, and cloud.sh.

# ── Shared ──
# Optional override. The default is quiet `cargo run -q` plus RUST_LOG=warn,cli=info
# (override tracing with NITRUM_E2E_RUST_LOG in build.sh, local.sh, and cloud.sh).
#   cargo run -q --manifest-path /absolute/path/to/nitrum/Cargo.toml --bin nitrum
# You can also set:
# export NITRUM_BIN="cargo run --manifest-path /absolute/path/to/nitrum/Cargo.toml --bin nitrum"

# Parent directory; `nitrum init <NITRUM_E2E_INIT_NAME>` runs here (creates <PARENT>/<NAME>/).
export NITRUM_E2E_PARENT_DIR=/absolute/path/to/nitrum/target/nitrum-e2e-workspace
export NITRUM_E2E_INIT_NAME=nitrum-e2e-demo

# Optional: override `[runtime]` images from nitrum.toml (see CONTRIBUTING.md for bake snippets).
# `nitrum local up` appends `-local` to the resolved data_plane tag automatically.
# export NITRUM_RUNTIME_CONTROL_PLANE_IMAGE=docker.io/matzapata/control-plane:dev
# export NITRUM_RUNTIME_DATA_PLANE_IMAGE=docker.io/matzapata/data-plane:dev
# export NITRUM_RUNTIME_NITRO_CLI_IMAGE=docker.io/matzapata/nitro-cli:dev

# ── cloud.sh only ──
export AWS_PROFILE=nitrum
export AWS_REGION=us-east-1

# Optional fixed origin for tests (skip CloudFormation NLB lookup)
# export ENCLAVE_URL=https://nitrum.local

export NITRUM_E2E_ENV_KEY=DEMO
export NITRUM_E2E_ENV_VALUE=hello

# export NITRUM_CLOUD_LOGS_SINCE_MINUTES=15
# export ENCLAVE_TLS_INSECURE=1

# ── local.sh only ──
# export ENCLAVE_URL=https://nitrum.local
# export ENCLAVE_TLS_INSECURE=1
# export NITRUM_LOCAL_LOGS_TAIL=80
