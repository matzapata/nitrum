{
  "name": "nitrum-node",
  "version": "1.0.0",
  "description": "Verify AWS Nitro Enclave attestation documents using Node.js >= 18.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write ."
  },
  "keywords": [
    "aws",
    "nitro",
    "enclave",
    "attestation",
    "tee",
    "cose",
    "cbor",
    "x509"
  ],
  "license": "MIT",
  "dependencies": {
    "@peculiar/x509": "^1.12.3",
    "cbor-x": "^1.6.0",
    "cose-js": "0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
