{
  "name": "nitro-attestation",
  "version": "1.0.0",
  "description": "Verify AWS Nitro Enclave attestation documents. Web-compatible — works in browsers, Node.js ≥ 18, Cloudflare Workers, and Deno.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "aws",
    "nitro",
    "enclave",
    "attestation",
    "tee",
    "cose",
    "cbor",
    "x509"
  ],
  "license": "MIT",
  "dependencies": {
    "@peculiar/webcrypto": "^1.4.6",
    "@peculiar/x509": "^1.12.3",
    "cbor-x": "^1.6.0",
    "cose-js": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
