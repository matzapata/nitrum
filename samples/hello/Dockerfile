ARG DATA_PLANE_IMAGE=nitrum/data-plane:dev
FROM ${DATA_PLANE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json .
RUN npm install
COPY src/main.js src/main.js

# Optional: copy self-signed TLS certs generated by `just gen-certs`.
# If the certs/ directory does not exist the plain (non-TLS) build still works.
COPY --chown=1500:1500 certs/ /app/certs/

CMD ["node", "src/main.js"]
