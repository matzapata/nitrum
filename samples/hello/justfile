# ── Dev (TCP transport) ───────────────────────────────────────────────────────

build:
    docker build -t nitrum/hello:dev .

rebuild:
    docker build --no-cache -t nitrum/hello:dev .


# ── Enclave (VSock transport) ─────────────────────────────────────────────────

build-enclave:
    docker build --build-arg DATA_PLANE_IMAGE=nitrum/data-plane:latest -t nitrum/hello:latest .

# ── Compose ───────────────────────────────────────────────────────────────────

up:
    docker compose up

down:
    docker compose down

logs:
    docker compose logs -f

restart:
    docker compose down && docker compose up

# ── E2E ───────────────────────────────────────────────────────────────────────

# Hit all app endpoints via ingress (HTTPS on port 3031). Requires stack to be up.
e2e:
    #!/usr/bin/env bash
    set -e
    base="https://localhost:3031"
    echo "→ GET $base/health"
    curl -sfk "$base/health" && echo ""
    echo "→ GET $base/egress"
    curl -sfk "$base/egress" | head -c 200 && echo ""
    echo "e2e OK"
