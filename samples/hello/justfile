DOCKERHUB_USER := "matzapata"

# ── Enclave (VSock transport) ─────────────────────────────────────────────────

# TODO: build docker image then enclave.eif then control-plane
build:
    docker build --platform linux/amd64 --build-arg FEATURES=enclave -f samples/hello/Dockerfile -t nitrum/hello:latest ../..

rebuild:
    docker build --platform linux/amd64 --no-cache --build-arg FEATURES=enclave -f samples/hello/Dockerfile -t nitrum/hello:latest ../..

push: 
    docker tag nitrum/hello:latest {{DOCKERHUB_USER}}/nitrum-hello:latest
    docker push {{DOCKERHUB_USER}}/nitrum-hello:latest

# ── Compose ───────────────────────────────────────────────────────────────────

up:
    docker compose up

down:
    docker compose down

logs:
    docker compose logs -f

restart:
    docker compose down && docker compose up

# ── E2E ───────────────────────────────────────────────────────────────────────

# Hit all app endpoints via ingress (HTTPS on port 443).
e2e:
    #!/usr/bin/env bash
    set -e
    base="https://localhost"
    echo "→ GET $base/health"
    curl -sfk "$base/health" && echo ""
    echo "→ GET $base/egress"
    curl -sfk "$base/egress" | head -c 200 && echo ""
    echo "e2e OK"
