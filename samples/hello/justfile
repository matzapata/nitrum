dockerhub_user := "matzapata"

# ── Build / run (tag = "dev" or "latest") ────────────────────────────────────
# From repo root build base first: `just build-data-plane dev` or `just build-data-plane latest`.

# Build hello image. tag="dev" uses data-plane:dev (no enclave); tag="latest" uses data-plane:latest (enclave).
build tag="latest" no_cache="":
    docker build --platform linux/amd64 \
        --build-arg DATA_PLANE_IMAGE={{dockerhub_user}}/nitrum-data-plane:{{tag}} \
        {{ if no_cache == "true" { "--no-cache" } else { "" } }} \
        -f Dockerfile \
        -t {{dockerhub_user}}/nitrum-hello:{{tag}} \
        .

# Build with --no-cache.
rebuild tag="latest":
    just build {{tag}} true

# Build then run with docker run --rm. Exposes 443 (ingress), 3000 (API).
run tag="latest":
    just build {{tag}}
    docker run --rm -p 443:443 -p 3000:3000 {{dockerhub_user}}/nitrum-hello:{{tag}}

# ── Compose ─────────────────────────────────────────────────────────────────

up:
    docker compose up

down:
    docker compose down

logs:
    docker compose logs -f

restart:
    docker compose down && docker compose up

# ── Push ─────────────────────────────────────────────────────────────────────

push tag="latest":
    docker push {{dockerhub_user}}/nitrum-hello:{{tag}}

# ── E2E ─────────────────────────────────────────────────────────────────────

# Hit all app endpoints via ingress (HTTPS on port 443).
e2e:
    #!/usr/bin/env bash
    set -e
    base="https://localhost"
    echo "→ GET $base/health"
    curl -sfk "$base/health" && echo ""
    echo "→ GET $base/egress"
    curl -sfk "$base/egress" | head -c 200 && echo ""
    echo "e2e OK"
