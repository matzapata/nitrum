# ── Certificates ──────────────────────────────────────────────────────────────

# Generate a self-signed TLS certificate valid for 365 days.
# Run this once before building TLS-enabled images.
gen-certs:
    mkdir -p certs
    openssl req -x509 -newkey rsa:4096 \
        -keyout certs/key.pem \
        -out certs/cert.pem \
        -days 365 \
        -nodes \
        -subj "/CN=localhost"

# ── Dev (TCP transport) ───────────────────────────────────────────────────────

build:
    docker build -t nitrum/hello:dev .

rebuild:
    docker build --no-cache -t nitrum/hello:dev .


# ── Enclave (VSock transport) ─────────────────────────────────────────────────

build-enclave:
    docker build --build-arg DATA_PLANE_IMAGE=nitrum/data-plane:latest -t nitrum/hello:latest .

# ── Compose ───────────────────────────────────────────────────────────────────

up:
    docker compose up

down:
    docker compose down

logs:
    docker compose logs -f

restart:
    docker compose down && docker compose up
