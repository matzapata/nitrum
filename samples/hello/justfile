DOCKERHUB_USER := "matzapata"

# ── Dev (TCP transport) ───────────────────────────────────────────────────────

build-dev:
    docker build --platform linux/amd64 -t nitrum/hello:dev .

rebuild-dev:
    docker build --platform linux/amd64 --no-cache -t nitrum/hello:dev .

push-dev: rebuild-dev
    docker tag nitrum/hello:dev {{DOCKERHUB_USER}}/nitrum-hello:dev
    docker push {{DOCKERHUB_USER}}/nitrum-hello:dev


# ── Enclave (VSock transport) ─────────────────────────────────────────────────

build:
    docker build --build-arg DATA_PLANE_IMAGE=matzapata/nitrum-data-plane:latest -t nitrum/hello:latest .

rebuild:
    docker build --platform linux/amd64 --no-cache --build-arg DATA_PLANE_IMAGE=matzapata/nitrum-data-plane:latest -t nitrum/hello:latest .

push: 
    docker tag nitrum/hello:latest {{DOCKERHUB_USER}}/nitrum-hello:latest
    docker push {{DOCKERHUB_USER}}/nitrum-hello:latest

# ── Compose ───────────────────────────────────────────────────────────────────

up:
    docker compose up

down:
    docker compose down

logs:
    docker compose logs -f

restart:
    docker compose down && docker compose up

# ── E2E ───────────────────────────────────────────────────────────────────────

# Hit all app endpoints via ingress (HTTPS on port 443).
e2e:
    #!/usr/bin/env bash
    set -e
    base="https://localhost"
    echo "→ GET $base/health"
    curl -sfk "$base/health" && echo ""
    echo "→ GET $base/egress"
    curl -sfk "$base/egress" | head -c 200 && echo ""
    echo "e2e OK"
