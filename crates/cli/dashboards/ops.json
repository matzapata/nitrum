{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Enclave running (per instance)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "SEARCH('{Nitrum/${ProjectName},Component,InstanceId} MetricName=\"EnclaveRunning\"', 'Average', 60)",
              "label": "EnclaveRunning",
              "id": "e1"
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "max": 1
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Ingress requests (sum / 1m, all instances)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "IngressRequests",
            "Component",
            "data-plane",
            {
              "stat": "Sum"
            }
          ]
        ]
      }
    },
    {
