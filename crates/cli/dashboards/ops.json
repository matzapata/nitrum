{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Enclave running (per instance)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "EnclaveRunning",
            "Component",
            "control-plane",
            "InstanceId",
            ".",
            { "label": "EnclaveRunning" }
          ]
        ],
        "yAxis": {
          "left": { "min": 0, "max": 1 }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Ingress requests (sum / 1m)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "IngressRequests",
            "Component",
            "data-plane",
            { "stat": "Sum" }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ACME cert days remaining (minimum)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 300,
        "stat": "Minimum",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "AcmeCertDaysRemaining",
            "Component",
            "data-plane",
            { "stat": "Minimum" }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Ingress 5xx (sum / 1m)",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "Ingress5xx",
            "Component",
            "data-plane",
            { "stat": "Sum" }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "App health check pass",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "AppHealthCheckPass",
            "Component",
            "data-plane",
            { "stat": "Average" }
          ]
        ],
        "yAxis": {
          "left": { "min": 0, "max": 1 }
        }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "KMS / DynamoDB errors",
        "view": "timeSeries",
        "stacked": true,
        "region": "${AWS_REGION}",
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "KmsErrors",
            "Component",
            "data-plane",
            { "stat": "Sum", "label": "KmsErrors" }
          ],
          [
            ".",
            "DynamoDbErrors",
            ".",
            ".",
            { "stat": "Sum", "label": "DynamoDbErrors" }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Enclave restarts",
        "view": "timeSeries",
        "stacked": false,
        "region": "${AWS_REGION}",
        "period": 300,
        "stat": "Sum",
        "metrics": [
          [
            "Nitrum/${ProjectName}",
            "EnclaveRestartCount",
            "Component",
            "control-plane",
            { "stat": "Sum" }
          ]
        ]
      }
    }
  ]
}
